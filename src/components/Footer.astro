---
import Logo from './Logo.astro';
import Edge from './Edge.astro';
import { business, nav, footer } from '../content/site';
const wa = `https://wa.me/${business.contact.whatsappNumber}?text=${encodeURIComponent('Hello Petal & Stem! I’d like to ask about flowers.')}`;
---

<footer class="site-footer on-dark">
  <Edge fill="rose-night" seed={21} />
  <div class="wrap foot-grid">
    <div class="foot-brand">
      <Logo tone="dark" />
      <p class="foot-line">{footer.line}</p>
      <a class="btn btn-cream" href="/order">Order for today</a>
    </div>

    <div class="foot-col">
      <h2 class="foot-h">Visit &amp; deliveries</h2>
      <ul>
        <li>{business.contact.address}</li>
        <li>{business.contact.deliveryHours}</li>
        <li>Same-day in {business.city} before {business.contact.sameDayCutoff}</li>
      </ul>
    </div>

    <div class="foot-col">
      <h2 class="foot-h">Talk to us</h2>
      <ul>
        <li><a href={business.contact.phoneHref}>{business.contact.phoneDisplay}</a></li>
        <li><a href={wa} target="_blank" rel="noopener">{business.contact.whatsappDisplay}</a></li>
        <li><a href={business.contact.emailHref}>{business.contact.email}</a></li>
      </ul>
    </div>

    <nav class="foot-col" aria-label="Footer">
      <h2 class="foot-h">Pages</h2>
      <ul>
        <li><a href="/">Home</a></li>
        {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        <li><a href="/order">Order</a></li>
      </ul>
    </nav>
  </div>

  <div class="wrap foot-base">
    <p>© {new Date().getFullYear()} {business.name}. All prices, contact details and reviews are placeholders.</p>
    <p class="concept">
      {footer.concept.before} <a href={business.studio.url} target="_blank" rel="noopener">{business.studio.name}</a>{footer.concept.after}
    </p>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    z-index: 4;
    background: var(--color-rose-night);
    color: var(--color-blush);
    padding-block: clamp(3.5rem, 7vw, 6rem) 6rem;
  }
  .foot-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 0.8fr;
    gap: 2.5rem;
  }
  .foot-brand { font-size: 1rem; display: grid; gap: 1.2rem; justify-items: start; align-content: start; }
  .foot-line { font-family: var(--font-display); font-style: italic; font-size: 1.35rem; line-height: 1.3; color: var(--color-cream); max-width: 22rem; }
  .foot-h { font-family: var(--font-sans); font-size: 0.78rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-gold-soft); margin-bottom: 0.8rem; }
  .foot-col ul { display: grid; gap: 0.2rem; font-size: 0.95rem; }
  .foot-col li { min-height: 2rem; display: flex; align-items: center; }
  .foot-col a { color: var(--color-cream); text-decoration: none; display: inline-flex; align-items: center; min-height: 44px; }
  .foot-col a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .foot-base {
    margin-top: 3rem;
    padding-top: 1.2rem;
    border-top: 1px solid rgb(220 192 138 / 0.25);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.6rem 2rem;
    font-size: 0.82rem;
    color: rgb(243 218 211 / 0.75);
  }
  .concept a { color: var(--color-gold-soft); text-underline-offset: 3px; display: inline-block; padding-block: 14px; margin-block: -14px; }
  @media (max-width: 900px) {
    .foot-grid { grid-template-columns: 1fr 1fr; }
    .foot-brand { grid-column: 1 / -1; }
  }
  @media (max-width: 520px) {
    .foot-grid { gap: 1.8rem 1.2rem; }
    .foot-col:nth-of-type(2) { grid-column: 1 / -1; }
  }
</style>
