---
/**
 * A hand-torn paper edge that sits on top of a section (no shadow, so nothing
 * spills into the section above). `fill` is a colour token name.
 */
interface Props {
  fill: string;
  seed?: number;
}
const { fill, seed = 3 } = Astro.props;
let a = seed;
const rand = () => {
  a = (a * 16807) % 2147483647;
  return (a - 1) / 2147483646;
};
const pts: string[] = [];
const N = 48;
for (let i = 0; i <= N; i++) {
  const x = (i / N) * 1440;
  const y = 22 + Math.sin(i * 0.42 + seed) * 7 + (rand() - 0.5) * 9;
  pts.push(`${x.toFixed(1)} ${y.toFixed(1)}`);
}
const d = `M0 48L${pts.join('L')}L1440 48Z`;
---

<svg class="edge" viewBox="0 0 1440 48" preserveAspectRatio="none" aria-hidden="true" focusable="false">
  <path d={d} fill={`var(--color-${fill})`}></path>
</svg>

<style>
  .edge {
    position: absolute;
    left: 0;
    bottom: calc(100% - 1px);
    width: 100%;
    height: clamp(18px, 3vw, 40px);
    display: block;
    pointer-events: none;
  }
</style>
