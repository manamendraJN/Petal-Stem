---
import Logo from './Logo.astro';
import { nav, business } from '../content/site';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="site-header" data-header>
  <div class="bar">
    <a href="/" class="brand" aria-label={`${business.name} — home`}>
      <Logo />
    </a>
    <nav class="nav" aria-label="Main">
      <ul>
        {nav.map((n) => (
          <li>
            <a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="actions">
      <a class="btn btn-rose order-btn" href="/order" aria-current={path === '/order' ? 'page' : undefined}>
        <span>Order<span class="hide-xs"> for today</span></span>
      </a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-menu" data-menu-open>
        <span class="sr-only">Open menu</span>
        <svg width="26" height="26" viewBox="0 0 26 26" aria-hidden="true"><path d="M4 9h18M4 17h12" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
      </button>
    </div>
  </div>
</header>

<!--
  The menu lives outside <header>: the header gets a backdrop-filter once scrolled, and
  that would turn it into the containing block for this fixed panel (clipping it to 68px).
-->
<div id="site-menu" class="menu on-dark" role="dialog" aria-modal="true" aria-label="Menu" hidden data-menu>
    <div class="menu-top">
      <Logo tone="dark" />
      <button class="menu-close" type="button" data-menu-close>
        <span class="sr-only">Close menu</span>
        <svg width="26" height="26" viewBox="0 0 26 26" aria-hidden="true"><path d="M6 6l14 14M20 6 6 20" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
      </button>
    </div>
    <ul class="menu-links">
      <li><a href="/" aria-current={path === '/' ? 'page' : undefined}>Home</a></li>
      {nav.map((n) => (
        <li>
          <a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a>
        </li>
      ))}
      <li><a href="/order" aria-current={path === '/order' ? 'page' : undefined}>Order for today</a></li>
    </ul>
    <div class="menu-contact">
      <a href={business.contact.phoneHref}>{business.contact.phoneDisplay}</a>
      <a href={business.contact.emailHref}>{business.contact.email}</a>
      <p>{business.contact.deliveryHours}</p>
    </div>
</div>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 60;
    height: var(--header-h);
    transition: background-color 0.35s, box-shadow 0.35s, translate 0.4s var(--ease-petal);
  }
  .site-header:global(.is-scrolled) {
    background: rgb(248 241 229 / 0.9);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: 0 1px 0 rgb(108 26 49 / 0.08);
  }
  /* Phones: a live backdrop blur over the animating hero is re-computed every frame.
     The bar is 90% opaque anyway, so a slightly more opaque fill looks the same. */
  @media (hover: none) and (pointer: coarse) {
    .site-header:global(.is-scrolled) {
      background: rgb(248 241 229 / 0.96);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
  }
  .bar {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-inline: var(--spacing-gutter);
  }
  .brand { display: inline-flex; align-items: center; min-height: 44px; text-decoration: none; font-size: 0.95rem; }
  .nav ul { display: flex; gap: clamp(1rem, 2vw, 2.2rem); }
  .nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--color-ink);
    text-decoration: none;
    background-image: linear-gradient(var(--color-rose), var(--color-rose));
    background-size: 0 1.5px;
    background-repeat: no-repeat;
    background-position: 0 calc(100% - 10px);
    transition: background-size 0.35s var(--ease-petal), color 0.2s;
  }
  .nav a:hover, .nav a[aria-current='page'] { background-size: 100% 1.5px; color: var(--color-rose-deep); }
  .actions { display: flex; align-items: center; gap: 0.5rem; }
  .order-btn { min-height: 44px; padding: 0.6rem 1.1rem; font-size: 0.92rem; }
  .menu-btn, .menu-close {
    display: none;
    width: 48px;
    height: 48px;
    align-items: center;
    justify-content: center;
    border: 0;
    background: transparent;
    color: var(--color-ink);
    cursor: pointer;
    border-radius: 12px;
  }
  @media (max-width: 1023px) {
    .nav { display: none; }
    .menu-btn { display: inline-flex; }
  }
  @media (max-width: 430px) {
    .hide-xs { display: none; }
  }

  .menu {
    position: fixed;
    inset: 0;
    z-index: 70;
    background: var(--color-rose-deep);
    color: var(--color-cream);
    padding: 0 var(--spacing-gutter) 2rem;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
  }
  .menu[hidden] { display: none; }
  .menu-top { height: var(--header-h); display: flex; align-items: center; justify-content: space-between; font-size: 0.95rem; }
  .menu-close { display: inline-flex; color: var(--color-cream); }
  .menu-links { margin-top: 2rem; display: grid; gap: 0.2rem; }
  .menu-links a {
    display: block;
    padding: 0.35rem 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 8vw, 3rem);
    font-weight: 340;
    line-height: 1.15;
    color: var(--color-cream);
    text-decoration: none;
  }
  .menu-links a[aria-current='page'] { font-style: italic; color: var(--color-gold-soft); }
  .menu-contact { margin-top: auto; padding-top: 2rem; display: grid; gap: 0.3rem; color: var(--color-blush); font-size: 0.95rem; }
  .menu-contact a { color: var(--color-cream); display: inline-block; padding-block: 0.5rem; }
</style>
