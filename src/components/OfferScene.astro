---
/** Scene 4 — the offer: bouquets grouped by feeling, same-day, drifting petals lead to ordering. */
import { home, feelings, sizes, business, whatsapp } from '../content/site';
import PhotoPlaceholder from './PhotoPlaceholder.astro';
import { petalSvg } from '../lib/shop';

const wa = `https://wa.me/${business.contact.whatsappNumber}?text=${encodeURIComponent(whatsapp.general)}`;
const tones = ['blush', 'paper', 'blush', 'paper', 'sage'] as const;
const drift = [
  { x: 8, y: 22, s: 1, c: ['blush', 'petal'] },
  { x: 30, y: 78, s: 0.7, c: ['peach', 'peach-deep'] },
  { x: 52, y: 14, s: 0.85, c: ['ivory', 'blush-deep'] },
  { x: 70, y: 86, s: 1.2, c: ['blush', 'petal'] },
  { x: 88, y: 30, s: 0.75, c: ['peach', 'peach-deep'] },
];
---

<section class="offer" data-scene="offer" id="menu" aria-labelledby="offer-title">
  <div class="offer-pin">
    <div class="wrap offer-head">
      <p class="kicker">{home.offer.kicker}</p>
      <h2 id="offer-title" class="offer-h">{home.offer.headline}</h2>
      <p class="offer-line">{home.offer.line}</p>
      <a class="link-arrow" href={home.offer.link.href}>
        {home.offer.link.label}
        <svg width="18" height="12" viewBox="0 0 18 12" aria-hidden="true"><path d="M1 6h15m-5-5 5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </a>
    </div>

    <div class="track-view">
      <div class="drift" aria-hidden="true">
        {drift.map((p, i) => (
          <div class="drift-petal" style={`--x:${p.x}%;--y:${p.y}%;--s:${p.s}`} set:html={petalSvg(`dp${i}`, p.c[0], p.c[1])} />
        ))}
      </div>
      <ul class="track" role="list">
        {feelings.map((f, i) => (
          <li class="card" style={`--tilt:${[-1.2, 0.8, -0.6, 1.1, -0.9][i]}deg`}>
            <article aria-labelledby={`menu-${f.id}`}>
              <h3 id={`menu-${f.id}`} class="card-feeling">{f.label}</h3>
              <PhotoPlaceholder label={`${f.bouquets[0].name} bouquet`} note="4:5 photo" ratio="4 / 5" tone={tones[i]} />
              <p class="card-name">{f.bouquets[0].name} <span>· {f.bouquets[1].name}</span></p>
              <p class="card-line">{f.line}</p>
              <p class="card-price">
                <span>from {sizes[0].price}</span>
                <span class="chip">Same-day</span>
              </p>
              <a class="card-link" href={`/order?feeling=${f.id}`} aria-label={`Order a ${f.label} bouquet`}>
                Choose <svg width="18" height="12" viewBox="0 0 18 12" aria-hidden="true"><path d="M1 6h15m-5-5 5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </a>
            </article>
          </li>
        ))}
        <li class="card card-end">
          <div>
            <p class="hand end-hand">Not sure what to send?</p>
            <p class="end-line">Tell us who it’s for. We’ll help you find the feeling — and the words.</p>
            <div class="end-cta">
              <a class="btn btn-cream" href="/order">Order for today</a>
              <a class="btn btn-line" href={wa} target="_blank" rel="noopener">Ask on WhatsApp</a>
            </div>
          </div>
        </li>
      </ul>
    </div>

  </div>
</section>

<style>
  .offer { position: relative; z-index: 3; background: var(--color-blush-50); }
  .offer-pin { position: relative; overflow: hidden; padding-block: clamp(4rem, 8vw, 7rem); }
  .offer-head {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    column-gap: 3rem;
    align-items: end;
  }
  .offer-head .kicker { grid-column: 1 / -1; }
  .offer-h { font-size: var(--text-title); line-height: var(--text-title--line-height); margin-top: 0.5rem; grid-row: 2; }
  .offer-h::after { content: ''; }
  .offer-line { grid-row: 2; grid-column: 2; font-size: var(--text-lead); color: var(--color-ink-soft); max-width: 28rem; }
  .offer-head .link-arrow { grid-row: 3; grid-column: 2; margin-top: 0.3rem; justify-self: start; }

  .track-view { position: relative; margin-top: clamp(2rem, 4vw, 3.5rem); }
  .track {
    display: flex;
    gap: clamp(1.2rem, 2.4vw, 2.4rem);
    padding-inline: var(--spacing-gutter);
    width: max-content;
    position: relative;
    z-index: 1;
  }
  .card { width: clamp(250px, 23vw, 330px); flex: none; rotate: var(--tilt); }
  .card article { display: flex; flex-direction: column; height: 100%; }
  .card-feeling {
    font-size: clamp(1.6rem, 2.3vw, 2.2rem);
    font-style: italic;
    white-space: nowrap;
    font-weight: 330;
    color: var(--color-rose-deep);
    line-height: 1;
    margin-bottom: 0.9rem;
  }
  .card-name { margin-top: 0.9rem; font-weight: 600; }
  .card-name span { font-weight: 400; color: var(--color-ink-soft); }
  .card-line { margin-top: 0.3rem; font-size: 0.95rem; color: var(--color-ink-soft); }
  .card-price { margin-top: 0.7rem; display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; font-weight: 600; color: var(--color-ink); }
  .chip { font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; padding: 0.2rem 0.55rem; border-radius: 999px; background: var(--color-stem); color: var(--color-cream); }
  .card-link {
    margin-top: auto;
    padding-top: 0.6rem;
    min-height: 44px;
    display: inline-flex; align-items: center; gap: 0.5rem;
    font-weight: 600; color: var(--color-rose); text-decoration: none;
  }
  .card-link:hover svg { transform: translateX(4px); }
  .card-link svg { transition: transform 0.3s var(--ease-petal); }
  .card-end {
    width: clamp(280px, 27vw, 380px);
    display: flex;
    align-items: center;
    padding: 2rem;
    border-radius: var(--radius-card);
    background: var(--color-rose-deep);
    color: var(--color-cream);
    rotate: 0deg;
  }
  .end-hand { font-size: 2.2rem; line-height: 1.05; color: var(--color-gold-soft); }
  .end-line { margin-top: 0.8rem; color: var(--color-blush); }
  .end-cta { margin-top: 1.4rem; display: flex; flex-direction: column; gap: 0.7rem; align-items: flex-start; }
  .card-end .btn-line { color: var(--color-cream); }
  .card-end .btn-line:hover { background: var(--color-cream); color: var(--color-rose-deep); border-color: var(--color-cream); }

  .drift { position: absolute; inset: -2rem 0; pointer-events: none; z-index: 0; }
  .drift-petal { position: absolute; left: var(--x); top: var(--y); width: calc(var(--s) * 34px); opacity: 0.9; }
  .drift-petal :global(svg) { width: 100%; height: auto; display: block; }

  /* Phones & still version: a two-per-row menu, no horizontal pin */
  @media (max-width: 860px) {
    .offer-head { grid-template-columns: 1fr; }
    .offer-h, .offer-line, .offer-head .link-arrow { grid-column: 1; grid-row: auto; }
    .offer-line { margin-top: 0.8rem; }
    .track { width: auto; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.6rem 0.9rem; }
    .card { width: auto; rotate: 0deg; }
    .card-feeling { font-size: clamp(1.15rem, 5.4vw, 1.5rem); margin-bottom: 0.6rem; }
    .card-line { display: none; }
    .card-name { font-size: 0.92rem; margin-top: 0.6rem; }
    .card-name span { display: none; }
    .card-price { font-size: 0.9rem; gap: 0.35rem; }
    .card-end { width: auto; padding: 1.1rem; }
    .end-hand { font-size: 1.6rem; }
    .end-line { font-size: 0.9rem; }
    .end-cta { align-items: stretch; }
    .end-cta .btn { min-height: 44px; padding: 0.6rem 0.7rem; font-size: 0.86rem; width: 100%; }
    .drift { display: none; }
  }
  @media (min-width: 861px) {
    .offer.is-horizontal .offer-pin { padding-block: calc(var(--header-h) + 1.25rem) 2rem; min-height: 100svh; }
    .offer.is-horizontal .card { width: clamp(200px, min(22vw, calc((100svh - 420px) * 0.68)), 330px); }
    .offer.is-horizontal .card-line { display: none; }
    .offer.is-horizontal .offer-h { font-size: clamp(2.2rem, 4vw, 3.6rem); }
    .offer.is-horizontal .track-view { margin-top: clamp(1.4rem, 3vh, 2.6rem); }
    :global(html:not(.motion)) .track { width: auto; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
    :global(html:not(.motion)) .card { width: auto; }
    :global(html:not(.motion)) .drift { display: none; }
  }
</style>
