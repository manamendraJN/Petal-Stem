---
/** Scene 3 — the proof: hands at the workbench, fresh each morning, notes by hand. */
import { home, sampleNotes } from '../content/site';
import PhotoPlaceholder from './PhotoPlaceholder.astro';
import Edge from './Edge.astro';
---

<section class="proof" data-scene="proof" id="craft" aria-labelledby="proof-title">
  <Edge fill="cream" seed={5} />
  <div class="wrap proof-grid">
    <div class="proof-text">
      <p class="kicker">{home.proof.kicker}</p>
      <h2 id="proof-title" class="proof-h">{home.proof.headline}</h2>
      <p class="proof-line">{home.proof.line}</p>
      <ul class="points">
        {home.proof.points.map((p) => (
          <li>
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 17C5 9 10 4 17 3C16 10 11 15 3 17Z" fill="var(--color-leaf)" /><path d="M3 17L13 7" stroke="var(--color-stem-deep)" stroke-width="1.2" /></svg>
            {p}
          </li>
        ))}
      </ul>
      <div class="proof-cta">
        <a class="btn btn-rose" href="/order">Order for today</a>
        <a class="link-arrow" href={home.proof.link.href}>
          {home.proof.link.label}
          <svg width="18" height="12" viewBox="0 0 18 12" aria-hidden="true"><path d="M1 6h15m-5-5 5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </a>
      </div>
    </div>

    <figure class="fig fig-main" data-speed="-0.12">
      <PhotoPlaceholder label="Hands arranging a bouquet at the wooden workbench" note="Portrait 4:5 · about 1600×2000 · under 500 KB" ratio="4 / 5" tone="blush" />
      <div class="note n1" data-note>
        <p class="hand note-text">{sampleNotes[0].text}</p>
        <span class="placeholder-tag sample">{sampleNotes[0].from}</span>
      </div>
    </figure>

    <figure class="fig fig-second" data-speed="-0.28">
      <PhotoPlaceholder label="This morning’s flowers in buckets, fresh from the market" note="Square 1:1 · about 1400×1400" ratio="1 / 1" tone="sage" />
      <div class="note n2" data-note>
        <p class="hand note-text">{sampleNotes[1].text}</p>
        <span class="placeholder-tag sample">{sampleNotes[1].from}</span>
      </div>
    </figure>

    <div class="note n3" data-note>
      <p class="hand note-text">{sampleNotes[2].text}</p>
      <span class="placeholder-tag sample">{sampleNotes[2].from}</span>
    </div>
  </div>
</section>

<style>
  .proof {
    position: relative;
    z-index: 3;
    background: var(--color-cream);
    padding-block: clamp(4rem, 9vw, 8rem) clamp(3rem, 7vw, 6rem);
  }
  .proof-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(1rem, 2.4vw, 2.5rem);
    align-items: start;
  }
  .proof-text { grid-column: 8 / 13; grid-row: 1; padding-top: clamp(1rem, 4vw, 4rem); }
  .proof-h { font-size: var(--text-title); line-height: var(--text-title--line-height); margin-top: 0.8rem; }
  .proof-line { margin-top: 1.2rem; font-size: var(--text-lead); color: var(--color-ink-soft); max-width: 32rem; }
  .points { margin-top: 1.6rem; display: grid; gap: 0.55rem; }
  .points li { display: flex; align-items: center; gap: 0.7rem; font-weight: 500; }
  .points svg { width: 20px; flex: none; }
  .proof-cta { margin-top: 2rem; display: flex; flex-wrap: wrap; align-items: center; gap: 0.8rem 1.6rem; }

  .fig { position: relative; margin: 0; }
  .fig-main { grid-column: 1 / 7; grid-row: 1 / 3; }
  .fig-second { grid-column: 8 / 12; grid-row: 2; margin-top: clamp(2rem, 6vw, 5rem); }

  .note {
    position: absolute;
    width: clamp(190px, 19vw, 270px);
    padding: 1.1rem 1.2rem 0.9rem;
    background: var(--color-ivory);
    border-radius: 3px;
    box-shadow: var(--shadow-lift);
    background-image: repeating-linear-gradient(transparent 0 27px, rgb(155 44 72 / 0.12) 27px 28px);
    background-position: 0 14px;
  }
  .note-text { font-size: clamp(1.3rem, 1.7vw, 1.6rem); line-height: 28px; color: var(--color-ink); }
  .note .sample {
    display: inline-block;
    margin-top: 0.6rem;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    background: var(--color-blush);
    color: var(--color-rose-deep);
  }
  .n1 { right: -14%; bottom: 8%; rotate: 4deg; }
  .n2 { left: -22%; top: -12%; rotate: -5deg; }
  .n3 { position: relative; grid-column: 3 / 7; grid-row: 3; margin-top: -7rem; rotate: -2deg; justify-self: start; z-index: 2; }

  @media (max-width: 860px) {
    .proof-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 2.2rem; }
    .proof-text { grid-column: 1 / -1; grid-row: 1; padding-top: 0; }
    .fig-main { grid-column: 1 / -1; grid-row: 2; }
    .fig-second { grid-column: 2; grid-row: 3; margin-top: 1rem; }
    .n1 { right: 4%; top: 7%; bottom: auto; width: min(62%, 240px); }
    .n2 { position: relative; inset: auto; width: 100%; margin-top: -1.4rem; rotate: 2deg; }
    .n3 { grid-column: 1; grid-row: 3; margin-top: 2.5rem; width: 100%; align-self: start; }
    .note-text { font-size: 1.22rem; line-height: 26px; }
    .note { padding: 0.9rem 0.9rem 0.75rem; background-size: 100% 26px; }
  }
</style>
