---
/**
 * Scripted chat helper — no AI, no server. Answers come from /src/content/site.ts.
 * Persists across page changes (transition:persist + sessionStorage).
 */
import { chat, business, whatsapp } from '../content/site';
const data = {
  greeting: chat.greeting,
  fallback: chat.fallback,
  answers: chat.answers,
  waNumber: business.contact.whatsappNumber,
  waGeneral: whatsapp.general,
};
---

<div class="chat" transition:persist="chat-helper" data-chat>
  <button class="chat-toggle" type="button" aria-expanded="false" aria-controls="chat-panel" data-chat-toggle>
    <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M12 3c4.4 0 8 3.1 8 7s-3.6 7-8 7c-.9 0-1.8-.1-2.6-.4L5 18.5l1.1-3.4C4.8 13.8 4 12 4 10c0-3.9 3.6-7 8-7Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path>
      <path d="M9 10h.01M12 10h.01M15 10h.01" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"></path>
    </svg>
    <span class="chat-toggle-text">Ask us</span>
  </button>

  <div id="chat-panel" class="chat-panel" role="dialog" aria-modal="false" aria-labelledby="chat-title" hidden data-chat-panel>
    <div class="chat-head">
      <p id="chat-title" class="chat-title">{chat.title}</p>
      <button type="button" class="chat-close" data-chat-close>
        <span class="sr-only">Close chat</span>
        <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M5 5l10 10M15 5 5 15" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
      </button>
    </div>
    <div class="chat-log" role="log" aria-live="polite" data-lenis-prevent data-chat-log></div>
    <div class="chat-quick" data-chat-quick>
      {chat.answers.slice(0, 5).map((a) => <button type="button" data-q={a.id}>{a.button}</button>)}
    </div>
    <form class="chat-form" data-chat-form>
      <label for="chat-input" class="sr-only">Type your question</label>
      <input id="chat-input" name="q" type="text" autocomplete="off" placeholder="Type a question…" maxlength="200" />
      <button type="submit" class="chat-send">
        <span class="sr-only">Send</span>
        <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 10h13m-5-5 5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      </button>
    </form>
    <p class="chat-foot">A simple helper with set answers — for anything else, <a href="/contact">message us</a>.</p>
  </div>
  <script type="application/json" data-chat-content set:html={JSON.stringify(data)} />
</div>

<script>
  import { initChat } from '../scripts/chat';
  initChat();
</script>

<style>
  .chat { position: fixed; right: max(1rem, env(safe-area-inset-right)); bottom: max(1rem, env(safe-area-inset-bottom)); z-index: 65; }
  .chat-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 52px;
    padding: 0.7rem 1.1rem 0.7rem 0.95rem;
    border: 0;
    border-radius: 999px;
    background: var(--color-stem-deep);
    color: var(--color-cream);
    font-weight: 600;
    cursor: pointer;
    box-shadow: 0 12px 28px -12px rgb(47 69 48 / 0.8);
    transition: transform 0.3s var(--ease-petal), background-color 0.2s;
  }
  .chat-toggle:hover { transform: translateY(-2px); background: var(--color-stem); }
  .chat-toggle[aria-expanded='true'] { opacity: 0; pointer-events: none; }
  .chat-panel {
    position: absolute;
    right: 0;
    bottom: 0;
    width: min(370px, calc(100vw - 2rem));
    max-height: min(560px, calc(100svh - 6rem));
    display: flex;
    flex-direction: column;
    background: var(--color-ivory);
    border-radius: 18px;
    box-shadow: var(--shadow-lift);
    overflow: hidden;
  }
  .chat-panel[hidden] { display: none; }
  .chat-head { display: flex; align-items: center; justify-content: space-between; padding: 0.4rem 0.4rem 0.4rem 1.1rem; background: var(--color-stem-deep); color: var(--color-cream); }
  .chat-title { font-family: var(--font-display); font-size: 1.15rem; }
  .chat-close { width: 44px; height: 44px; display: inline-flex; align-items: center; justify-content: center; border: 0; background: transparent; color: inherit; cursor: pointer; border-radius: 10px; }
  .chat-log { flex: 1; overflow-y: auto; padding: 1rem; display: flex; flex-direction: column; gap: 0.6rem; min-height: 160px; overscroll-behavior: contain; }
  .chat-log :global(.msg) { max-width: 88%; padding: 0.6rem 0.85rem; border-radius: 14px; font-size: 0.94rem; line-height: 1.45; }
  .chat-log :global(.bot) { align-self: flex-start; background: var(--color-blush-50); border-bottom-left-radius: 4px; color: var(--color-ink); }
  .chat-log :global(.me) { align-self: flex-end; background: var(--color-rose); color: var(--color-cream); border-bottom-right-radius: 4px; }
  .chat-log :global(.msg a) { display: inline-flex; align-items: center; min-height: 44px; margin-top: 0.1rem; margin-right: 0.8rem; font-weight: 600; color: var(--color-rose); }
  .chat-quick { display: flex; flex-wrap: wrap; gap: 0.4rem; padding: 0 1rem 0.6rem; }
  .chat-quick button {
    min-height: 44px;
    padding: 0.4rem 0.8rem;
    border-radius: 999px;
    border: 1.5px solid var(--color-blush-deep);
    background: transparent;
    font-size: 0.86rem;
    color: var(--color-rose-deep);
    cursor: pointer;
  }
  .chat-quick button:hover { background: var(--color-blush-50); }
  .chat-form { display: flex; gap: 0.4rem; padding: 0.6rem 0.8rem; border-top: 1px solid var(--color-blush); }
  .chat-form input { flex: 1; min-height: 46px; padding: 0.5rem 0.8rem; border-radius: 12px; border: 1.5px solid var(--color-blush-deep); background: var(--color-cream); }
  .chat-form input:focus { outline: none; border-color: var(--color-rose); }
  .chat-send { width: 46px; min-height: 46px; border: 0; border-radius: 12px; background: var(--color-rose); color: var(--color-cream); cursor: pointer; display: inline-flex; align-items: center; justify-content: center; }
  .chat-foot { padding: 0 1rem 0.7rem; font-size: 0.75rem; color: var(--color-ink-soft); }
  .chat-foot a { color: var(--color-rose); }
  @media (max-width: 520px) {
    .chat-toggle-text { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    .chat-toggle { width: 54px; height: 54px; padding: 0; justify-content: center; }
    .chat-panel { position: fixed; left: 0.6rem; right: 0.6rem; bottom: 0.6rem; width: auto; max-height: 72svh; }
  }
</style>
